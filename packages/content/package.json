{
  "name": "@redan/content",
  "version": "0.1.0",
  "private": true,
  "description": "Parcels as JSON (doc 8.3). Hand-authored example content proving the schema round-trips into @redan/sim — not campaign content yet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "preview": "pnpm run build && node scripts/preview.mjs",
    "generate-land": "node scripts/generate-land.mjs"
  },
  "dependencies": {
    "@redan/schema": "workspace:*",
    "@redan/sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "eslint": "^9.14.0",
    "typescript-eslint": "^8.13.0"
  }
}
